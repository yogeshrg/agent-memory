# Application
APP_NAME="Agent Memory"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8002

# Vector Store
VECTOR_DIM=768
VECTOR_INDEX_PATH=./data/vector_index.faiss
VECTOR_METADATA_PATH=./data/vector_metadata.json

# Graph Store
GRAPH_DB_PATH=./data/graph.db

# Episodic Store
EPISODIC_DB_PATH=./data/episodic.db

# Memory Settings
CONSOLIDATION_INTERVAL=3600
IMPORTANCE_THRESHOLD=0.5
MAX_SHORT_TERM_ITEMS=100
FORGETTING_CURVE_HALF_LIFE=86400

# Embedding
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768